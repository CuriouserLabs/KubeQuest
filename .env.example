# Firebase web app configuration.
# Copy this file to `.env`, then fill in the values from:
#   Firebase console -> Project settings -> General -> Your apps -> SDK setup and configuration
#
# These values are read at build time by Vite (import.meta.env.*).
# Note: Firebase web config values are not secrets (they ship in the client bundle),
# but keeping them in env vars keeps the repo portable and open-source friendly.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
