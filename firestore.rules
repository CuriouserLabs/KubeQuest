rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Each user may read and write ONLY their own progress document.
    // Nobody can list or read anyone else's progress.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Kubetopia (the game at play.kubequest.org) keeps its save-games in a
    // separate collection so it can never collide with study-plan data.
    // Same rule: each player owns exactly their own document.
    match /kubetopia/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Kubetopia campaign run history: private to its owner. Runs are
    // append-only from the client (nobody can edit or read anyone else's).
    match /kubetopia_campaign_runs/{uid}/runs/{runId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update, delete: if false;
    }

    // Kubetopia campaign leaderboards: world-readable (signed in or not).
    // Each player may write ONLY their own entry, and the entry's uid must
    // match them. Campaign scores are client-attested for now; competitive
    // modes will move to an API-only verified write path later.
    match /kubetopia_leaderboards/{boardId}/entries/{uid} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.data.uid == uid;
    }
    match /kubetopia_leaderboards/{boardId} {
      allow read: if true;
      allow write: if false; // board metadata is not client-managed
    }

    // Anonymous aggregate counter: "N people are studying this plan".
    // - Anyone (including signed-out visitors) can read the count.
    // - A signed-in user may only ever increment it by exactly 1
    //   (done once, when their user document is first created).
    // - No individual data is ever stored here.
    match /stats/global {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['studiers'])
        && request.resource.data.studiers == 1;
      allow update: if request.auth != null
        && request.resource.data.keys().hasOnly(['studiers'])
        && request.resource.data.studiers == resource.data.studiers + 1;
      allow delete: if false;
    }

    // Deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
