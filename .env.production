# Firebase WEB config for the production project (kubequest-dd648).
#
# These values are NOT secrets: Firebase web config is meant to ship in the
# client bundle and is already publicly visible in the deployed site's JS.
# Google's guidance: web API keys don't grant data access — that is enforced
# by Firebase Auth + Firestore security rules. So it is safe to commit these.
#
# Vite loads this file automatically for `npm run build` (production mode),
# so deploys pick up the config with no extra setup. For local development
# you can still create a gitignored `.env` to override these.
#
# Do NOT put the Admin SDK service-account key here — that IS a secret and
# must stay out of git (see serviceAccountKey.example.json).

VITE_FIREBASE_API_KEY=AIzaSyDzo6QVYmRJZhzk1Ug2kJj8TTeVArhkWJs
VITE_FIREBASE_AUTH_DOMAIN=kubequest-dd648.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=kubequest-dd648
VITE_FIREBASE_STORAGE_BUCKET=kubequest-dd648.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=251179039389
VITE_FIREBASE_APP_ID=1:251179039389:web:f7e0c86e1c79f0bc5b3274
